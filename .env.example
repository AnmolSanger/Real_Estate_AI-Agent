GOOGLE_API_KEY=your_gemini_api_key_here
SERPER_API_KEY=your_serper_api_key_here
# Optional: override the default model
# GEMINI_MODEL=gemini/gemini-3.1-flash-lite

# Clients send this in the X-API-Key header
ESTATEMIND_API_KEY=choose_a_long_random_key

# Optional: S3-compatible storage. Without these, reports save to ./artifacts/
# AWS_ACCESS_KEY_ID=your_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_ENDPOINT_URL=https://s3.your-region.backblazeb2.com
# S3_BUCKET=your_bucket_name
# AWS_DEFAULT_REGION=your-region

# Optional: require a password before the Streamlit demo can run a report
# DEMO_PASSWORD=choose_a_password
